<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Scripts/MainStyle.uss?fileID=7433441132597879392&amp;guid=8608c9f4c9ce0fc4b8306d735e94bea8&amp;type=3#MainStyle"/>
    <GameUIManager style="flex-grow: 1; margin-left: 0; margin-right: 0; margin-top: 0; margin-bottom: 0;">
        <ui:VisualElement name="PlayScreen" style="flex-grow: 1; justify-content: space-between; margin-left: 0%; margin-right: 0%; margin-top: 0%; margin-bottom: 0%; overflow: hidden; display: flex;">
            <ui:VisualElement name="Top" style="align-items: stretch; flex-direction: column; justify-content: flex-start; align-self: stretch; flex-grow: 0;">
                <ui:VisualElement name="Panel-Score" class="imagePanel" style="background-image: url(&quot;project://database/Assets/Textures/Panel_Score.png?fileID=2800000&amp;guid=0491387b925892d4e81db638b2a1654f&amp;type=3#Panel_Score&quot;); -unity-background-scale-mode: stretch-to-fill; justify-content: space-around; align-self: stretch; align-items: center; flex-direction: row; -unity-slice-type: sliced; padding-right: 2%; padding-left: 2%; filter: drop-shadow(0 0 5.44 rgb(38, 79, 96)); padding-bottom: 7%; padding-top: 3%; -unity-slice-left: 330; -unity-slice-right: 330; -unity-slice-scale: -0.2px;">
                    <ui:Label text="00" display-tooltip-when-elided="true" name="points-p1" class="scoreText"/>
                    <ui:VisualElement name="turn-indicator-p1" style="border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; background-color: rgb(59, 59, 79); -unity-background-scale-mode: stretch-to-fill; height: 10px; width: 10px; justify-content: flex-start; flex-shrink: 0; border-left-color: rgb(34, 34, 34); border-right-color: rgb(34, 34, 34); border-top-color: rgb(34, 34, 34); border-bottom-color: rgb(34, 34, 34); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px;"/>
                    <ui:Label text="..." display-tooltip-when-elided="true" name="bot-message" class="scoreText" style="-unity-font: none; width: 55%; white-space: nowrap; margin-top: 0%; padding-top: 5%; padding-bottom: 5%; background-color: rgb(12, 11, 11); border-top-left-radius: 22px; border-top-right-radius: 22px; border-bottom-right-radius: 22px; border-bottom-left-radius: 22px; margin-right: 5%; margin-left: 5%; flex-grow: 0; flex-shrink: 0.5; height: 0%; font-size: 14px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/AERO.TTF?fileID=12800000&amp;guid=d8b9a103109579240a9888c6d4a75273&amp;type=3#AERO&quot;);"/>
                    <ui:VisualElement name="turn-indicator-p2" style="border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; background-color: rgb(47, 55, 49); -unity-background-scale-mode: stretch-to-fill; height: 10px; width: 10px; justify-content: flex-start; flex-shrink: 0; border-left-color: rgb(34, 34, 34); border-right-color: rgb(34, 34, 34); border-top-color: rgb(34, 34, 34); border-bottom-color: rgb(34, 34, 34); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px; visibility: visible;"/>
                    <ui:Label text="00" display-tooltip-when-elided="true" name="points-p2" class="scoreText"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="Center" style="flex-grow: 3;"/>
            <ui:VisualElement name="Panel-Bottom" style="flex-grow: 0.1; align-items: flex-end; justify-content: space-between; flex-direction: row; background-image: url(&quot;project://database/Assets/Textures/Panel_Buttons.png?fileID=2800000&amp;guid=3809e8c4ac6b3e740b93b1d0c2c6d94b&amp;type=3#Panel_Buttons&quot;); -unity-slice-type: sliced; -unity-background-scale-mode: stretch-to-fill; flex-shrink: 0; padding-right: 6%; padding-left: 6%; padding-bottom: 4%; align-self: stretch; -unity-slice-left: 291; -unity-slice-scale: 0; -unity-slice-right: 305; padding-top: 12px;">
                <ui:Button text="Quit" name="Quit" class="button1 button2" style="flex-grow: 0; border-top-left-radius: 15px; border-top-right-radius: 15px; border-bottom-right-radius: 15px; border-bottom-left-radius: 15px; width: 75px;"/>
                <ui:Button text="UNDO" display-tooltip-when-elided="true" name="Undo" class="button1" style="flex-grow: 0; display: none; overflow: visible; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-left-color: rgb(202, 189, 43); border-right-color: rgb(202, 189, 43); border-top-color: rgb(202, 189, 43); border-bottom-color: rgb(202, 189, 43); color: rgb(199, 200, 0); font-size: 10px; margin-top: 0; margin-bottom: 5px; padding-top: 5px; padding-bottom: 5px; padding-right: 10px; padding-left: 10px;"/>
                <ui:Button text="Reset" name="Reset" class="button1" style="flex-grow: 0; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; width: 75px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="GameOver" style="flex-grow: 1; visibility: visible; display: none; overflow: hidden; flex-shrink: 1; background-color: rgba(0, 0, 0, 0.58); justify-content: flex-start; margin-top: 25%;">
            <ui:VisualElement name="WinContainer" class="panel" style="justify-content: flex-start; align-items: center; flex-direction: column;">
                <ui:VisualElement name="Scores" style="flex-direction: row; justify-content: center; width: 50%; height: 33%;">
                    <ui:VisualElement name="Red" style="background-color: rgb(197, 0, 0); border-top-left-radius: 10px; border-bottom-left-radius: 10px;">
                        <ui:Label text="02" display-tooltip-when-elided="true" name="finalScore-p1" class="scoreText"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="Green" style="background-color: rgb(0, 135, 18); border-top-right-radius: 10px; border-bottom-right-radius: 10px;">
                        <ui:Label text="02" display-tooltip-when-elided="true" name="final-score-p2" class="scoreText"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label text="GRAY WINS." display-tooltip-when-elided="true" name="WinText" class="title"/>
                <ui:VisualElement name="Buttons" style="justify-content: center; align-items: flex-end; flex-direction: row;">
                    <ui:Button text="Reset" display-tooltip-when-elided="true" name="Reset" class="button1"/>
                    <ui:Button text="View Board" display-tooltip-when-elided="true" name="ViewBoard" class="button1" style="flex-grow: 1; padding-left: 18px; padding-right: 14px;"/>
                    <ui:Button text="Quit" display-tooltip-when-elided="true" name="Quit" class="button1" style="flex-grow: 1; padding-left: 18px; padding-right: 14px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </GameUIManager>
</ui:UXML>
