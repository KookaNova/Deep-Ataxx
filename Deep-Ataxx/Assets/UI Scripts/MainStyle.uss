.scoreText {
    white-space: nowrap;
    -unity-font-definition: url("project://database/Assets/Fonts/CLUBLAND.TTF?fileID=12800000&guid=3edc3d995a2c4e04abe508091ec394c9&type=3#CLUBLAND");
    color: rgb(244, 255, 208);
    -unity-text-auto-size: best-fit 14px 37px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    background-color: rgba(22, 22, 22, 0);
    padding-left: 8px;
    height: 65%;
    backdrop-filter: none;
}

.button1:hover {
    color: rgb(255, 255, 255);
    background-color: rgb(161, 49, 98);
    transition-duration: 0.1s;
    scale: 1.03 1.03;
    border-left-color: rgb(25, 25, 25);
    border-right-color: rgb(25, 25, 25);
    border-top-color: rgb(25, 25, 25);
    border-bottom-color: rgb(25, 25, 25);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.button1 {
    color: rgb(0, 200, 150);
    background-color: rgba(12, 16, 41, 0.65);
    border-left-color: rgb(185, 34, 108);
    border-right-color: rgb(185, 34, 108);
    border-top-color: rgb(185, 34, 108);
    border-bottom-color: rgb(185, 34, 108);
    -unity-font-style: normal;
    -unity-font-definition: url("project://database/Assets/Fonts/GOMARICE_BITTER_AND_SUGAR.TTF?fileID=12800000&guid=08981423f59599245bda5c8adf38b177&type=3#GOMARICE_BITTER_AND_SUGAR");
    letter-spacing: 6px;
    flex-grow: 0.5;
    -unity-background-image-tint-color: rgb(0, 200, 150);
    background-position-x: center;
    background-repeat: no-repeat no-repeat;
    -unity-background-scale-mode: scale-to-fit;
    background-size: 30px 30px;
    padding-top: 15px;
    padding-right: 15px;
    padding-bottom: 15px;
    padding-left: 15px;
}

.menuText {
    -unity-font: url("project://database/Library/unity%20default%20resources?fileID=10102&guid=0000000000000000e000000000000000&type=0#LegacyRuntime");
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.81);
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 5px;
    padding-bottom: 5px;
    font-size: 12px;
    white-space: normal;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Fonts/ETHNOCENTRIC%20RG.OTF?fileID=12800000&guid=476b1626c8366c0429443ca56346b326&type=3#ETHNOCENTRIC RG");
}

.menuText2 {
    font-size: 16px;
    -unity-font: url("project://database/Library/unity%20default%20resources?fileID=10102&guid=0000000000000000e000000000000000&type=0#LegacyRuntime");
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.81);
    padding-left: 3px;
    padding-right: 3px;
    padding-top: 3px;
    padding-bottom: 3px;
}

.title {
    -unity-font-definition: url("project://database/Assets/Fonts/EARTHORBITERBOLD.TTF?fileID=12800000&guid=f6d1c6286764cdc4c832a873e21ac3bc&type=3#EARTHORBITERBOLD");
    white-space: normal;
    filter: drop-shadow(0 0 0.61 rgb(255, 0, 43));
}

.gridClass {
    background-color: rgba(22, 22, 22, 0.73);
    margin-left: 5px;
    margin-right: 5px;
    margin-top: 5px;
    margin-bottom: 5px;
    align-items: flex-start;
    justify-content: space-between;
    flex-direction: row-reverse;
    padding-left: 3px;
    padding-right: 3px;
    padding-top: 3px;
    padding-bottom: 3px;
    color: rgb(229, 229, 229);
    backdrop-filter: sepia(1) blur(1.86);
    -unity-font-definition: url("project://database/Assets/Fonts/FRADM.TTF?fileID=12800000&guid=465774718177fb14494e524b3ef83457&type=3#FRADM");
    -unity-font-style: normal;
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-left-color: rgb(21, 24, 26);
    border-right-color: rgb(21, 24, 26);
    border-top-color: rgb(21, 24, 26);
    border-bottom-color: rgb(21, 24, 26);
}

.gridClass:focus {
    background-color: rgba(91, 28, 6, 0.361);
    transition-duration: 0.25s;
    border-left-color: rgb(223, 241, 37);
    border-right-color: rgb(223, 241, 37);
    border-top-color: rgb(223, 241, 37);
    border-bottom-color: rgb(223, 241, 37);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
}

.panel {
    background-color: rgb(26, 24, 50);
    margin-left: 5px;
    margin-right: 5px;
    margin-top: 5px;
    margin-bottom: 5px;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 5px;
    padding-bottom: 5px;
    color: rgb(238, 238, 238);
}

.characterIcon {
    flex-grow: 1;
    height: 100%;
    align-items: center;
    aspect-ratio: 1;
    background-color: rgb(0, 0, 0);
}

.score-box {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-top-left-radius: 25px;
    border-bottom-left-radius: 25px;
    border-top-right-radius: 25px;
    border-bottom-right-radius: 25px;
    border-left-color: rgba(46, 59, 84, 255);
    border-right-color: rgba(46, 59, 84, 255);
    border-top-color: rgba(46, 59, 84, 255);
    border-bottom-color: rgba(46, 59, 84, 255);
    align-items: center;
    justify-content: space-around;
}
